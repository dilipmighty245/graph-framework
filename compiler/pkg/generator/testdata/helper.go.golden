		"gnses.gns.nexus.com":                                        {"roots.root.nexus.com", "configs.config.nexus.com"},
		"ignorechilds.gns.nexus.com":                                 {"roots.root.nexus.com", "configs.config.nexus.com", "gnses.gns.nexus.com"},
		"optionalparentpathparams.optionalparentpathparam.nexus.com": {"roots.root.nexus.com", "configs.config.nexus.com", "gnses.gns.nexus.com"},
		"roots.root.nexus.com":                                       {},
