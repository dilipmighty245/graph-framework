		"svcgroups.servicegroup.nexus.com":                           {"roots.root.nexus.com", "configs.config.nexus.com", "gnses.gns.nexus.com"},
		"vmpolicies.policypkg.nexus.com":                             {"roots.root.nexus.com", "configs.config.nexus.com"},
